{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "glint-gemini-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "QUOTA", "class_name": "GlobalQuota" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GlobalQuota"] }]
}
