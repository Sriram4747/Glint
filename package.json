{
  "name": "glint",
  "version": "1.0.0",
  "description": "AI-powered desktop navigation assistant",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "relay:deploy": "node scripts/deploy-gemini-relay.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:desktop": "node tests/desktop/run.cjs",
    "test:planner": "node --test tests/planner-decision.test.cjs",
    "test:navigation": "node tests/desktop/navigation.cjs",
    "test:automation": "node tests/desktop/navigation.cjs --agent",
    "test:automation:windows": "node tests/desktop/navigation.cjs --agent-live",
    "test:nested": "node tests/desktop/navigation.cjs --nested-fixture",
    "test:nested:windows": "node tests/desktop/navigation.cjs --nested-live",
    "setup:voice": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-voice.ps1",
    "preview": "electron-vite preview",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.0"
  }
}
